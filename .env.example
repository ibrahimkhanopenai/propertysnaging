# ─── Site ───────────────────────────────────────────────
# Public base URL. MUST stay https://propertyinspectors.me in production (SEO).
NEXT_PUBLIC_SITE_URL=https://propertyinspectors.me

# ─── Database (MySQL 8+) ────────────────────────────────
DATABASE_URL="mysql://pi_user:pi_password@localhost:3306/propertyinspectors"

# ─── Admin auth ─────────────────────────────────────────
# Long random string (min 32 chars). Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Used ONLY by `npm run db:seed` to create the first admin user
ADMIN_EMAIL=admin@propertyinspectors.me
ADMIN_PASSWORD=ChangeThisPassword123!

# ─── Pricing (quote calculator) ─────────────────────────
# Price per bedroom in AED. Studio counts as 1 bedroom. Commercial = price on request.
PRICE_PER_BEDROOM=10
PRICE_CURRENCY=AED

# ─── Email (SMTP) for lead notifications ────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Property Inspectors <no-reply@propertyinspectors.me>"
LEAD_NOTIFY_TO=info@propertyinspectors.me

# ─── Uploads (admin blog images) ────────────────────────
# Absolute or relative folder outside /public. Served at /uploads/*
UPLOAD_DIR=./storage/uploads

# ─── Analytics (copy IDs from the current WordPress site) ─
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# ─── WordPress source (migration scripts only) ──────────
WP_SOURCE_URL=https://propertyinspectors.me
